//@version=5
indicator("Yield Strength", overlay=true, scale=scale.right)

// === Inputs ===
yield_tf  = input.timeframe("60", "Yield timeframe")
ema_tf    = input.timeframe("60", "EMA timeframe")
maturity  = input.string("10Y", "Yield Maturity", options=["02Y", "05Y", "10Y"])
ema_fast  = input.int(120, "EMA Curta")
ema_slow  = input.int(216, "EMA Longa")
minBars   = input.int(3, "Mínimo de barras viradas pra confirmar", minval=1)

moeda = input.string("USD", "Moeda", options=["USD","EUR","GBP","JPY","AUD","NZD","CAD","CHF"])

// === Funções ===
f_yieldSymbol(curr) =>
    baseSym = switch curr
        "USD" => "US"
        "EUR" => "DE"
        "JPY" => "JP"
        "GBP" => "GB"
        "CHF" => "CH"
        "AUD" => "AU"
        "NZD" => "NZ"
        "CAD" => "CA"
        => ""
    baseSym == "" ? "" : "TVC:" + baseSym + maturity

getYield(curr) =>
    request.security(f_yieldSymbol(curr), yield_tf, close)

// === YIELDS (8 securities) ===
y_USD = getYield("USD")
y_EUR = getYield("EUR")
y_GBP = getYield("GBP")
y_JPY = getYield("JPY")
y_AUD = getYield("AUD")
y_NZD = getYield("NZD")
y_CAD = getYield("CAD")
y_CHF = getYield("CHF")

// === AGREGADO ===
getAgregado(m) =>
    float result = na
    if m == "USD"
        result := y_USD - (y_EUR+y_GBP+y_JPY+y_AUD+y_NZD+y_CAD+y_CHF)/7
    else if m == "EUR"
        result := y_EUR - (y_USD+y_GBP+y_JPY+y_AUD+y_NZD+y_CAD+y_CHF)/7
    else if m == "GBP"
        result := y_GBP - (y_USD+y_EUR+y_JPY+y_AUD+y_NZD+y_CAD+y_CHF)/7
    else if m == "JPY"
        result := y_JPY - (y_USD+y_EUR+y_GBP+y_AUD+y_NZD+y_CAD+y_CHF)/7
    else if m == "AUD"
        result := y_AUD - (y_USD+y_EUR+y_GBP+y_JPY+y_NZD+y_CAD+y_CHF)/7
    else if m == "NZD"
        result := y_NZD - (y_USD+y_EUR+y_GBP+y_JPY+y_AUD+y_CAD+y_CHF)/7
    else if m == "CAD"
        result := y_CAD - (y_USD+y_EUR+y_GBP+y_JPY+y_AUD+y_NZD+y_CHF)/7
    else
        result := y_CHF - (y_USD+y_EUR+y_GBP+y_JPY+y_AUD+y_NZD+y_CAD)/7
    result

spread = getAgregado(moeda)

// === EMAs + contador de barras confirmadas, tudo calculado dentro do ema_tf ===
emaAndCounter() =>
    e1 = ta.ema(spread, ema_fast)
    e2 = ta.ema(spread, ema_slow)
    var int bUp = 0
    var int bDown = 0
    if e1 > e2
        bUp := bUp + 1
        bDown := 0
    else
        bDown := bDown + 1
        bUp := 0
    [e1, e2, bUp, bDown]

[ema1, ema2, barsUp, barsDown] = request.security(syminfo.tickerid, ema_tf, emaAndCounter())

confirmedUp   = barsUp   >= minBars
confirmedDown = barsDown >= minBars

var color currentColor = color.gray
if confirmedUp
    currentColor := color.lime
else if confirmedDown
    currentColor := color.red
else
    currentColor := color.gray

bull_confirmado = barsUp   == minBars
bear_confirmado = barsDown == minBars

plot(spread, "Agregado", color=color.gray)
plot(ema1, "EMA Curta", color=currentColor, linewidth=2)
plot(ema2, "EMA Longa", color=currentColor, linewidth=2)

// === Setas grudadas no candle ===
plotshape(bull_confirmado, title="Confirmado Alta", location=location.belowbar, style=shape.triangleup, color=color.lime, size=size.small)
plotshape(bear_confirmado, title="Confirmado Baixa", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.small)

// === Coloração especial do candle conforme estado confirmado ===
barcolor(confirmedUp ? color.lime : confirmedDown ? color.red : na, title="Cor do Candle")
